PORT=5000
# Leave MONGODB_URL empty to use the automatic in-memory MongoDB, or specify a MongoDB URI:
# MONGODB_URL=mongodb://localhost:27017/chatbot
# MONGODB_URL=mongodb+srv://<user>:<password>@cluster.mongodb.net/chatbot
MONGODB_URL=

COOKIE_SECRET=chatbot_cookie_secret_super_secure_key_2026
JWT_SECRET=chatbot_jwt_secret_super_secure_key_2026

# Optional: AI Provider API Keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GROK_API_KEY=
GROK_MODEL=grok-2-latest

